# Flutter/Dart
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
*.iml
.idea/
.vscode/

# Gerado no build a partir do google-services.json
lib/firebase_options.dart

# Pasta android/ é gerada no GitHub Actions (flutter create);
# só o arquivo do Firebase fica versionado.
android/*
!android/app/
android/app/*
!android/app/google-services.json

# Pasta ios/ é gerada no GitHub Actions (flutter create);
# só o arquivo do Firebase para iOS fica versionado (quando existir).
ios/*
!ios/Runner/
ios/Runner/*
!ios/Runner/GoogleService-Info.plist

# Cloud Functions
functions/node_modules/

# Pasta web/ é gerada no GitHub Actions (flutter create)
/web/
